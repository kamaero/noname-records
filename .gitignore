# No trailing slash: in a git worktree this is a symlink to the main checkout's
# node_modules (the toolchain is not duplicated per worktree), and a directory-only
# rule would leave that symlink showing up as untracked.
frontend/node_modules
frontend/dist/
frontend/*.tsbuildinfo
backups/
data/

