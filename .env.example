# Настройки Noname Records. Установщик (install.sh / install.ps1) создаёт .env сам —
# этот файл нужен, только если вы настраиваете всё вручную или хотите что-то поменять.
# После правки .env перезапустите систему: docker compose up -d

# ── Студия ───────────────────────────────────────────────────────────────────────
# Как студия называет себя в письмах дикторам и на сайте.
STUDIO_NAME=Noname Records
# Кому писать «нужно больше времени» — в дательном падеже: «Ольге». Пусто — «в студию».
STUDIO_CONTACT_NAME=
# Адрес сайта, как его открывают люди. На своём компьютере — http://localhost:8080,
# на сервере — https://ваш-домен.
APP_BASE_URL=http://localhost:8080

# ── Безопасность ─────────────────────────────────────────────────────────────────
# Случайный ключ подписи сессий, не короче 32 символов. Установщик создаёт его сам.
# Вручную: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 1 — система не запустится с небезопасным SECRET_KEY.
PRODUCTION=1
# Вход администратора. Хеш пароля создаёт установщик; вручную:
#   docker compose run --rm web python scripts/generate_password_hash.py
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=
# true — cookie только по HTTPS (сервер с доменом); false — для http://localhost.
COOKIE_SECURE=false
# Ограничение попыток входа — защита от перебора паролей.
AUTH_RATE_LIMIT=10/minute

# ── Нейросети (ключи — ваши, платите вы напрямую провайдеру) ─────────────────────
# Разметка книги: кто какую реплику говорит, список персонажей. Обязательно.
# Ключ: https://platform.deepseek.com → API keys.
DEEPSEEK_API_KEY=
# Можно размечать моделью Claude вместо DeepSeek (точнее, дороже):
# ключ https://console.anthropic.com, затем DEFAULT_FINAL_PROVIDER=claude и
# DEFAULT_FINAL_MODEL=claude-sonnet-4-6 (то же для DEFAULT_CHAR_EXTRACTION_*).
CLAUDE_API_KEY=
DEFAULT_FINAL_PROVIDER=deepseek
DEFAULT_FINAL_MODEL=deepseek-v4-pro
DEFAULT_CHAR_EXTRACTION_PROVIDER=deepseek
DEFAULT_CHAR_EXTRACTION_MODEL=deepseek-v4-pro
# Консилиум (вторая проверка разметки) и звуковая разметка сцен. Необязательно.
# RouterAI принимает оплату в рублях: https://routerai.ru
ROUTERAI_API_KEY=
# Сверка записей диктора с текстом (распознавание речи): openai или routerai.
ASR_PROVIDER=openai
ASR_MODEL=whisper-1
# Ключ OpenAI нужен, если ASR_PROVIDER=openai: https://platform.openai.com
OPENAI_API_KEY=
# Фоновые звуки сцен (эмбиент). Необязательно: https://elevenlabs.io
ELEVENLABS_API_KEY=

# ── Telegram-бот (необязательно) ─────────────────────────────────────────────────
# Бот присылает дикторам назначения на роли, сроки и реплики для перезаписи, выдаёт
# логин и пароль. Работает только на сервере с доменом и HTTPS.
# Создать бота: @BotFather в Telegram → /newbot.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# Любая длинная случайная строка — Telegram подписывает ею запросы к сайту.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NOTIFY_ENABLED=false
# Ваш Telegram id (узнать: @userinfobot). Сюда приходят сводки и вопросы системы.
OWNER_TELEGRAM_ID=

# ── Хранение ─────────────────────────────────────────────────────────────────────
# База и записи. В Docker это папка data рядом с docker-compose.yml.
DATABASE_URL=sqlite:///./data/noname.db
AUDIO_STORAGE_PATH=/app/data/recordings
# Вторая копия записей — на другом диске или сетевом хранилище (NAS). Пусто — без
# зеркала. Каталог должен уже существовать и не лежать внутри AUDIO_STORAGE_PATH.
AUDIO_NAS_PATH=
# Сколько гигабайт держать свободными: при нехватке приём записи вежливо откажет.
LOCAL_RESERVE_GB=2
