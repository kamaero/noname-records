# Noname Records settings. The installer (install.sh / install.ps1) creates .env.
# Use this example for manual configuration or to find settings you want to change.
# After editing .env, apply the changes: docker compose up -d

# -- Studio ───────────────────────────────────────────────────────────────────────
# Studio name used in messages to voice actors and on the website.
STUDIO_NAME=Noname Records
# New empty databases only; the selected calendar is frozen in the database.
STUDIO_TIMEZONE=UTC
# Contact name for requests for more time. Leave blank to refer to the studio.
STUDIO_CONTACT_NAME=
# Optional author slug for a human-verified data/canon_kb.sqlite roster. Blank disables it.
CANON_AUTHOR_SLUG=
# Website address used by people. On your computer: http://localhost:8080;
# on a server: https://your-domain.example.
APP_BASE_URL=http://localhost:8080

# -- Security ─────────────────────────────────────────────────────────────────
# Random session-signing key, at least 32 characters. Generated by the installer.
# To generate manually: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts AI keys saved through the website. Generated by the installer.
# If blank, derived from SECRET_KEY. Changing it requires re-entering saved AI keys.
KEYS_ENCRYPTION_KEY=
# 1 prevents startup with an insecure SECRET_KEY.
PRODUCTION=1
# Administrator login. The installer hashes the password. To generate it manually:
#   docker compose run --rm web python scripts/generate_password_hash.py
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=
# true: HTTPS-only cookies (server with a domain); false: local HTTP installation.
COOKIE_SECURE=false
# Limit sign-in attempts to protect against password guessing.
AUTH_RATE_LIMIT=10/minute

# -- AI providers (your own keys; you pay providers directly) ─────────────────────
# You can manage keys on the website in Settings -> AI providers. Website keys
# take precedence; these are fallback keys for manual configuration.
# Default book attribution and character extraction provider.
# Key: https://platform.deepseek.com → API keys.
DEEPSEEK_API_KEY=
# To select Claude instead of DeepSeek:
# get a key at https://console.anthropic.com, then set DEFAULT_FINAL_PROVIDER=claude and
# DEFAULT_FINAL_MODEL=claude-sonnet-4-6 (also configure DEFAULT_CHAR_EXTRACTION_*).
CLAUDE_API_KEY=
DEFAULT_FINAL_PROVIDER=deepseek
DEFAULT_FINAL_MODEL=deepseek-v4-pro
DEFAULT_CHAR_EXTRACTION_PROVIDER=deepseek
DEFAULT_CHAR_EXTRACTION_MODEL=deepseek-v4-pro
# Optional attribution review and scene sound planning.
# RouterAI supports payments in rubles: https://routerai.ru
ROUTERAI_API_KEY=
# Align actor recordings with the source text (speech recognition): openai or routerai.
ASR_PROVIDER=openai
ASR_MODEL=whisper-1
# Strict narrator auditing is paid and disabled until explicitly enabled.
# It requires a RouterAI key; the price depends on duration and provider tariffs.
ASR_AUDIT_ENABLED=0
# ASR_AUDIT_MODEL=elevenlabs/scribe-v2
# ASR_AUDIT_CONFIRM_MODEL=microsoft/mai-transcribe-2
# LLM_AUDIT_MODEL=deepseek/deepseek-v4-pro
# An OpenAI key is required when ASR_PROVIDER=openai: https://platform.openai.com
OPENAI_API_KEY=
# Optional scene ambience: https://elevenlabs.io
ELEVENLABS_API_KEY=

# -- Telegram bot (optional) ─────────────────────────────────────────────────
# The bot sends actors role assignments, deadlines and lines to record again, and
# provides login details. Requires a server with a domain and HTTPS.
# Create a bot: @BotFather in Telegram -> /newbot.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# A long random string used to authenticate Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NOTIFY_ENABLED=false
# Your Telegram ID (find it with @userinfobot), for owner summaries and questions.
OWNER_TELEGRAM_ID=

# -- Storage ─────────────────────────────────────────────────────────────────────
# Database and recordings. In Docker, stored in data next to docker-compose.yml.
DATABASE_URL=sqlite:///./data/noname.db
AUDIO_STORAGE_PATH=/app/data/recordings
# Optional recording mirror on another disk or network storage (NAS). Leave blank
# to disable. The directory must exist and must not be nested in AUDIO_STORAGE_PATH.
AUDIO_NAS_PATH=
# Minimum free gigabytes; new uploads are refused when free space is below this.
LOCAL_RESERVE_GB=2
